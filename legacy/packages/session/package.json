{
	"name": "@frelion/bone-session",
	"version": "0.2.1",
	"description": "Bone conversation persistence, branching, and session contracts",
	"type": "module",
	"main": "./dist/index.js",
	"types": "./dist/index.d.ts",
	"exports": {
		".": {
			"types": "./dist/index.d.ts",
			"import": "./dist/index.js"
		}
	},
	"files": [
		"dist",
		"README.md",
		"CHANGELOG.md"
	],
	"scripts": {
		"clean": "shx rm -rf dist",
		"build": "tsgo -p tsconfig.build.json",
		"test": "bunx --bun vitest --run --passWithNoTests",
		"prepublishOnly": "bun run clean && bun run build"
	},
	"dependencies": {
		"@frelion/bone-agent-core": "^0.2.1",
		"@frelion/bone-ai": "^0.2.1",
		"typebox": "1.1.38"
	},
	"devDependencies": {
		"@types/node": "24.12.4",
		"shx": "0.4.0",
		"typescript": "5.9.3",
		"vitest": "4.1.9"
	},
	"license": "MIT",
	"engines": {
		"bun": ">=1.3.14"
	}
}
